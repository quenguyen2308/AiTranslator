<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/layoutAddImageSlot"
    android:layout_width="66dp"
    android:layout_height="66dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="bottom|start"
        android:background="@drawable/bg_add_image_slot"
        android:orientation="vertical"
        android:gravity="center">

        <ImageView
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/ic_camera_pill"
            app:tint="@color/primary_indigo"
            android:contentDescription="Thêm ảnh" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="+ Thêm"
            android:textColor="@color/primary_indigo"
            android:textSize="10sp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
