<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_screen">

    <!-- Modern App Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="16dp"
        android:background="@color/surface_card"
        android:elevation="1dp">

        <!-- App Icon -->
        <ImageView
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@mipmap/ic_launcher"
            android:contentDescription="Icon ứng dụng" />

        <!-- Title & Active Model Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="AI Translator"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="2dp">

                <View
                    android:layout_width="6dp"
                    android:layout_height="6dp"
                    android:background="@drawable/bg_chip_indigo"
                    android:backgroundTint="@color/tag_success" />

                <TextView
                    android:id="@+id/tvActiveModel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Gemini 1.5 Flash"
                    android:textSize="11sp"
                    android:textColor="@color/text_secondary" />
            </LinearLayout>
        </LinearLayout>

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_settings_btn"
            android:contentDescription="Cài đặt"
            android:padding="9dp"
            android:scaleType="fitCenter" />
    </LinearLayout>

    <!-- Language Selector Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_lang"
            android:padding="4dp">

            <TextView
                android:id="@+id/tvSourceLang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_chip_indigo"
                android:text="🌐 Tự động nhận diện"
                android:textColor="@color/primary_indigo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingHorizontal="4dp" />

            <ImageView
                android:id="@+id/btnSwapLang"
                android:layout_width="38dp"
                android:layout_height="match_parent"
                android:layout_marginHorizontal="2dp"
                android:src="@drawable/ic_swap_lang"
                android:contentDescription="Đổi chiều dịch"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp" />

            <TextView
                android:id="@+id/tvTargetLang"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:background="@drawable/bg_chip_indigo"
                android:text="🇻🇳 Tiếng Việt"
                android:textColor="@color/primary_indigo"
                android:textSize="12sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?attr/selectableItemBackground"
                android:singleLine="true"
                android:ellipsize="end"
                android:paddingHorizontal="4dp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Main Scrollable Body -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollViewMain"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Card 1: All-In-One Input Card -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card_modern"
                android:padding="14dp"
                android:elevation="2dp">

                <!-- Input Text Area with Clear Button -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <EditText
                        android:id="@+id/etInputText"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="96dp"
                        android:background="@null"
                        android:gravity="top|start"
                        android:hint="Nhập hoặc dán văn bản cần dịch..."
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:textColorHint="@color/text_muted"
                        android:inputType="textMultiLine"
                        android:lineSpacingExtra="3dp"
                        android:paddingEnd="32dp"
                        android:importantForAutofill="no" />

                    <ImageButton
                        android:id="@+id/btnClearText"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_alignParentTop="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_clear_text"
                        android:contentDescription="Xóa văn bản"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </RelativeLayout>

                <!-- Selected Image Preview Chip (if selected) -->
                <RelativeLayout
                    android:id="@+id/layoutImagePreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_indigo"
                    android:padding="8dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/ivSelectedImage"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:scaleType="centerCrop"
                        android:background="@drawable/bg_chip_slate"
                        android:contentDescription="Ảnh OCR" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_toEndOf="@id/ivSelectedImage"
                        android:layout_toStartOf="@id/btnClearImage"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="10dp"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Ảnh đã chọn (OCR)"
                            android:textColor="@color/text_primary"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Đã nén tối ưu (1024px)"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnClearImage"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_close"
                        android:contentDescription="Xóa ảnh"
                        android:padding="6dp"
                        android:scaleType="fitCenter" />
                </RelativeLayout>

                <!-- Input Footer Toolbar -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingTop="10dp"
                    android:layout_marginTop="6dp">

                    <!-- Button: Pick Image OCR -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPickImage"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip_indigo"
                        app:backgroundTint="@null"
                        android:text="Chọn ảnh OCR"
                        android:textColor="@color/primary_indigo_dark"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_camera_pill"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@null" />

                    <!-- Button: Paste from Clipboard -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnPaste"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip_slate"
                        app:backgroundTint="@null"
                        android:text="Dán"
                        android:textColor="#1E293B"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_paste"
                        android:drawablePadding="6dp"
                        android:paddingHorizontal="12dp"
                        android:stateListAnimator="@null" />

                    <!-- Character Counter -->
                    <TextView
                        android:id="@+id/tvCharCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="end"
                        android:text="0 ký tự"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

            <!-- Translation Style Selector -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_modern"
                android:paddingHorizontal="14dp"
                android:paddingVertical="8dp"
                android:elevation="1dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Phong cách:"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary" />

                <RadioGroup
                    android:id="@+id/rgTranslationStyle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:gravity="end">

                    <RadioButton
                        android:id="@+id/rbStyleAccurate"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🎯 Chuẩn xác"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:checked="true"
                        android:buttonTint="@color/primary_indigo"
                        android:layout_marginEnd="6dp" />

                    <RadioButton
                        android:id="@+id/rbStylePoetic"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="🌸 Hoa mỹ"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:buttonTint="@color/primary_indigo" />
                </RadioGroup>
            </LinearLayout>

            <!-- Main Gradient CTA Button with integrated loading state -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginTop="14dp">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSend"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_btn_gradient"
                    app:backgroundTint="@null"
                    android:text="✨  Dịch với Gemini AI"
                    android:textAllCaps="false"
                    android:textColor="@color/color_btn_text"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:stateListAnimator="@null"
                    android:elevation="3dp" />

                <LinearLayout
                    android:id="@+id/layoutBtnLoading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:elevation="4dp"
                    android:visibility="gone">

                    <ProgressBar
                        android:id="@+id/progressBar"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:indeterminateTint="@color/text_white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Đang dịch..."
                        android:textColor="@color/text_white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </FrameLayout>

            <!-- Card 2: Result Card -->
            <LinearLayout
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:orientation="vertical"
                android:background="@drawable/bg_card_modern"
                android:padding="16dp"
                android:elevation="2dp">

                <!-- Result Header Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <View
                        android:layout_width="8dp"
                        android:layout_height="8dp"
                        android:background="@drawable/bg_chip_indigo"
                        android:backgroundTint="@color/tag_success" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:text="KẾT QUẢ DỊCH"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_muted"
                        android:letterSpacing="0.08" />

                    <!-- Quick Copy Button -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnCopyResult"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:background="@drawable/bg_chip_indigo"
                        app:backgroundTint="@null"
                        android:text="Sao chép"
                        android:textColor="@color/primary_indigo_dark"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:drawableStart="@drawable/ic_copy"
                        android:drawablePadding="4dp"
                        android:paddingHorizontal="10dp"
                        android:stateListAnimator="@null"
                        android:visibility="gone" />

                    <!-- Quick Share Button -->
                    <ImageButton
                        android:id="@+id/btnShareResult"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_share"
                        android:contentDescription="Chia sẻ"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />

                    <!-- Quick Clear Result Button -->
                    <ImageButton
                        android:id="@+id/btnClearResult"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_trash"
                        android:contentDescription="Xóa kết quả"
                        android:padding="6dp"
                        android:scaleType="fitCenter"
                        android:visibility="gone" />
                </LinearLayout>

                <!-- Result Box (Full height, expands with content, no internal scroll) -->
                <FrameLayout
                    android:id="@+id/layoutResultBox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="140dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/bg_result_box"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/tvResult"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="112dp"
                        android:textColor="@color/text_primary"
                        android:textSize="15sp"
                        android:lineSpacingExtra="5dp"
                        android:textIsSelectable="true" />
                </FrameLayout>

                <!-- Result Status Footer -->
                <LinearLayout
                    android:id="@+id/layoutResultMeta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvResultModel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Gemini 1.5 Flash • Key 1"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvResultSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="⚡ 0.6s"
                        android:textColor="@color/text_muted"
                        android:textSize="11sp" />
                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>
